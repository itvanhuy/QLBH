{
  "info": {
    "name": "Restaurant Management API",
    "description": "Bộ API test cho hệ thống quản lý bán hàng nhà hàng.\n\n**Hướng dẫn sử dụng:**\n1. Import Environment file\n2. Chạy request Login Admin → token tự động lưu\n3. Test các API theo thứ tự từng folder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" }
  ],
  "item": [

    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.token) {",
                "  pm.environment.set('token', res.data.token);",
                "  pm.environment.set('adminToken', res.data.token);",
                "  console.log('Token saved:', res.data.token.substring(0, 30) + '...');",
                "}",
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Has token', () => pm.expect(res.data.token).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - Staff",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.token) {",
                "  pm.environment.set('staffToken', res.data.token);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login - Customer",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.token) {",
                "  pm.environment.set('customerToken', res.data.token);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Test\",\n  \"email\": \"test@gmail.com\",\n  \"password\": \"123456\",\n  \"phone\": \"0901234999\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Get Me (Current User)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Login - Wrong Password (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },

    {
      "name": "2. Users (Admin only)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?page=0&size=20",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get All Users - Filter by Role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?role=ROLE_CUSTOMER&page=0",
              "query": [
                { "key": "role", "value": "ROLE_CUSTOMER" },
                { "key": "page", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/users/1"
          }
        },
        {
          "name": "Lock User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/users/7/lock"
          }
        },
        {
          "name": "Unlock User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/users/7/unlock"
          }
        },
        {
          "name": "Change Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"ROLE_STAFF\"\n}" },
            "url": "{{baseUrl}}/users/4/role"
          }
        }
      ]
    },

    {
      "name": "3. Categories",
      "item": [
        {
          "name": "Get All Categories (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Món đặc biệt\",\n  \"description\": \"Các món ăn đặc biệt của nhà hàng\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Món khai vị\",\n  \"description\": \"Cập nhật mô tả\"\n}"
            },
            "url": "{{baseUrl}}/categories/1"
          }
        },
        {
          "name": "Delete Category (403 - has products)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/categories/1"
          }
        }
      ]
    },

    {
      "name": "4. Products",
      "item": [
        {
          "name": "Get All Products (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Products - Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?categoryId=2&status=AVAILABLE",
              "query": [
                { "key": "categoryId", "value": "2" },
                { "key": "status", "value": "AVAILABLE" }
              ]
            }
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?keyword=bún",
              "query": [{ "key": "keyword", "value": "bún" }]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/1"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phở gà đặc biệt\",\n  \"description\": \"Phở gà nước dùng trong, thơm ngon\",\n  \"price\": 65000,\n  \"categoryId\": 2,\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phở bò tái chín\",\n  \"description\": \"Phở bò cập nhật\",\n  \"price\": 70000,\n  \"categoryId\": 2,\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": "{{baseUrl}}/products/6"
          }
        }
      ]
    },

    {
      "name": "5. Tables",
      "item": [
        {
          "name": "Get All Tables (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tables"
          }
        },
        {
          "name": "Create Table",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"11\",\n  \"capacity\": 6\n}"
            },
            "url": "{{baseUrl}}/tables"
          }
        },
        {
          "name": "Update Table Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESERVED\"\n}"
            },
            "url": "{{baseUrl}}/tables/9/status"
          }
        }
      ]
    },

    {
      "name": "6. Orders",
      "item": [
        {
          "name": "Get All Orders (Staff)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get My Orders (Customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/orders/my-orders"
          }
        },
        {
          "name": "Create Order (Staff)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.id) {",
                "  pm.environment.set('orderId', res.data.id);",
                "  console.log('Order ID saved:', res.data.id);",
                "}",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": 3,\n  \"note\": \"Ít cay\",\n  \"items\": [\n    { \"productId\": 4, \"quantity\": 2 },\n    { \"productId\": 14, \"quantity\": 2 },\n    { \"productId\": 18, \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Update Status → CONFIRMED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Update Status → CANCELLED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CANCELLED\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Get Orders - Filter PENDING",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders?status=PENDING",
              "query": [{ "key": "status", "value": "PENDING" }]
            }
          }
        }
      ]
    },

    {
      "name": "7. Payments",
      "item": [
        {
          "name": "Create Payment (Step 1)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.id) {",
                "  pm.environment.set('paymentId', res.data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"method\": \"CASH\"\n}"
            },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "Confirm Payment (Step 2)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/payments/{{paymentId}}/confirm"
          }
        },
        {
          "name": "Get Payment by Order ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/payments/order/2"
          }
        },
        {
          "name": "Payment - Already Paid (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 2,\n  \"method\": \"CASH\"\n}"
            },
            "url": "{{baseUrl}}/payments"
          }
        }
      ]
    },

    {
      "name": "8. Dashboard (Admin)",
      "item": [
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/dashboard/statistics"
          }
        },
        {
          "name": "Get Revenue by Date Range",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard/revenue?from=2026-09-01&to=2026-09-30",
              "query": [
                { "key": "from", "value": "2026-09-01" },
                { "key": "to",   "value": "2026-09-30" }
              ]
            }
          }
        },
        {
          "name": "Get Revenue Monthly",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard/revenue/monthly?year=2026",
              "query": [{ "key": "year", "value": "2026" }]
            }
          }
        },
        {
          "name": "Get Top Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard/top-products?limit=5",
              "query": [{ "key": "limit", "value": "5" }]
            }
          }
        }
      ]
    },

    {
      "name": "9. Error Cases",
      "item": [
        {
          "name": "401 - No Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "403 - Customer access Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "404 - Product not found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/99999"
          }
        },
        {
          "name": "400 - Order table OCCUPIED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": 5,\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "400 - Validation Error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    }

  ]
}
